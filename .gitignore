# ==========================================
# Terraform
# ==========================================

# Terraform working directory
**/.terraform/
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*.plan

# Terraform variable files
# Ignore secrets/environment-specific variables
*.tfvars
*.tfvars.json

# Allow example tfvars
!*.tfvars.example
!*.tfvars.template

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file
# IMPORTANT: keep this file in Git for reproducible provider versions
!.terraform.lock.hcl


# ==========================================
# Secrets / Credentials
# ==========================================

# .env
# .env.*
# !.env.example

*.pem
*.key
*.crt

credentials
credentials.*
.aws/
*.credentials


# ==========================================
# Terraform CLI / Logs
# ==========================================

.terraformrc
terraform.rc

*.log


# ==========================================
# OS files
# ==========================================

.DS_Store
Thumbs.db

# Windows
Desktop.ini

# Linux
*~

# ==========================================
# IDE
# ==========================================

.vscode/
.idea/

*.swp
*.swo


# ==========================================
# Temporary files
# ==========================================

*.tmp
*.temp
*.bak
*.backup