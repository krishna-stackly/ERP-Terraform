/*
 * ============================================================
 * LOAD SHARED LIBRARY
 *
 * Always use the main branch of the shared library.
 * ============================================================
 */

@Library('erp-shared-library@main') _


/*
 * ============================================================
 * BRANCH VALIDATION
 *
 * Execute this deployment pipeline only when running
 * from the application's main branch.
 * ============================================================
 */

if (env.BRANCH_NAME != 'main') {

    echo """

==================================================
PIPELINE NOT EXECUTED
==================================================

Current Branch : ${env.BRANCH_NAME}
Allowed Branch : main

This deployment pipeline runs only from the main branch.

==================================================
"""

    currentBuild.result = 'NOT_BUILT'

    return
}


/*
 * ============================================================
 * CALL ERP SHARED PIPELINE
 *
 * Static configuration is passed from this caller.
 *
 * VERSION and ENVIRONMENT parameters are created
 * by the shared library.
 * ============================================================
 */

erpPipeline(

    /*
     * ========================================================
     * AWS CONFIGURATION
     * ========================================================
     */

    accountId: '699975678958',

    awsRegion: 'us-east-1',


    /*
     * ========================================================
     * TERRAFORM / INFRASTRUCTURE CONFIGURATION
     *
     * These values are used together with the selected
     * environment to discover AWS infrastructure.
     * ========================================================
     */

    projectName: 'erp',

    pocName: 'Krishna',


    /*
     * ========================================================
     * JENKINS AWS CREDENTIAL
     *
     * This must exactly match the Jenkins Credential ID.
     * ========================================================
     */

    awsCredentials: 'aws-erp',


    /*
     * ========================================================
     * DEPLOYMENT ENVIRONMENTS
     *
     * Jenkins displays:
     *
     * Dev
     * QA
     *
     * The shared library converts the selected value to
     * lowercase for AWS Terraform tag discovery.
     * ========================================================
     */

    environments: [

        'Dev': 'Dev',

        'QA': 'QA'
    ]
)