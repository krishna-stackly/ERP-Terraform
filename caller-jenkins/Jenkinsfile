/*
 * ============================================================
 * LOAD SHARED LIBRARY
 *
 * Always use the main branch of the shared library.
 * ============================================================
 */

@Library('erp-shared-library@main') _


/*
 * ============================================================
 * BRANCH VALIDATION
 *
 * Execute this deployment pipeline only when running
 * from the main branch.
 * ============================================================
 */

if (env.BRANCH_NAME != 'main') {

    echo """
==================================================
PIPELINE NOT EXECUTED
==================================================

Current Branch : ${env.BRANCH_NAME}
Allowed Branch : main

This deployment pipeline runs only from the main branch.

==================================================
"""

    currentBuild.result = 'NOT_BUILT'

    return
}


/*
 * ============================================================
 * CALL ERP SHARED PIPELINE
 *
 * VERSION and ENVIRONMENT are created inside the
 * shared library as Jenkins parameters.
 * ============================================================
 */

erpPipeline(

    /*
     * ========================================================
     * AWS CONFIGURATION
     * ========================================================
     */

    accountId: '699975678958',

    awsRegion: 'us-east-1',


    /*
     * ========================================================
     * PROJECT CONFIGURATION
     *
     * These values must match the EC2 resource tags.
     * ========================================================
     */

    projectName: 'erp',

    pocName: 'Krishna',


    /*
     * ========================================================
     * JENKINS AGENT
     * ========================================================
     */

    agentLabel: 'jenkins-agent-007',


    /*
     * ========================================================
     * AWS CREDENTIALS
     *
     * Jenkins Credential ID.
     * ========================================================
     */

    awsCredentials: 'aws-erp',


    /*
     * ========================================================
     * DEPLOYMENT ENVIRONMENTS
     *
     * Jenkins displays:
     *
     * Dev
     * QA
     *
     * The shared library converts these to lowercase
     * when querying AWS tags:
     *
     * Dev -> dev
     * QA  -> qa
     * ========================================================
     */

    environments: [

        'Dev': 'Dev',

        'QA': 'QA'

    ]

)